{
	"name": "shaped-gallery",
	"version": "1.2.0",
	"description": "ShapedGallery — WordPress gallery plugin: visual layout picker, justified / grid / masonry layouts, future-proof media providers.",
	"author": "ShapedPlugin LLC",
	"license": "GPL-2.0-or-later",
	"main": "dist/block/index.js",
	"scripts": {
		"start:block": "wp-scripts start app/blocks/gallery/index.js --output-path=dist/block",
		"start:admin": "wp-scripts start app/admin/shaped-dashboard.js --output-path=dist/admin",
		"start:front": "wp-scripts start app/frontend/shaped-layout.js --output-path=dist/frontend",
		"start:lightbox": "wp-scripts start app/frontend/lightbox.js --output-path=dist/frontend",
		"build:block": "wp-scripts build app/blocks/gallery/index.js --output-path=dist/block",
		"build:admin": "wp-scripts build app/admin/shaped-dashboard.js --output-path=dist/admin",
		"build:front": "wp-scripts build app/frontend/shaped-layout.js --output-path=dist/frontend",
		"build:lightbox": "wp-scripts build app/frontend/lightbox.js --output-path=dist/frontend",
		"build": "npm run build:block && npm run build:admin && npm run build:front && npm run build:lightbox && npm run generate-json && npm run postbuild",
		"generate-json": "node generate-json.js",
		"postbuild": "find dist -name '*-rtl.css' -type f -delete && find dist -name '*.css.map' -type f -delete",
		"format": "wp-scripts format ./app",
		"lint:js": "wp-scripts lint-js app",
		"lint:css": "wp-scripts lint-style 'app/**/*.scss'",
		"packages-update": "wp-scripts packages-update",
		"package": "node build-zip.js",
		"release": "npm run build && npm run i18n && npm run package",
		"makepot": "wp i18n make-pot . languages/easy-lightbox-wp.pot --exclude=dist,node_modules,vendor,tests,playwright-report,test-results",
		"generate-i18n-map": "node generate-i18n-map.js",
		"makejson": "npm run generate-i18n-map && wp i18n make-json languages --no-purge --use-map=languages/i18n-map.json",
		"makemo": "wp i18n make-mo languages",
		"i18n": "npm run makepot && npm run makejson && npm run makemo",
		"test:unit": "wp-scripts test-unit-js --config jest-unit.config.js",
		"test:e2e": "playwright test --config playwright.config.ts",
		"test": "npm run test:unit"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@wordpress/e2e-test-utils-playwright": "^1.32.0",
		"@wordpress/eslint-plugin": "^22.18.0",
		"@wordpress/scripts": "^30.21.0",
		"archiver": "^7.0.1",
		"prettier": "^3.2.5",
		"webpack": "^5.102.1",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.0",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@wordpress/api-fetch": "^7.32.0",
		"@wordpress/block-editor": "^15.4.0",
		"@wordpress/blocks": "^15.4.0",
		"@wordpress/components": "^30.4.0",
		"@wordpress/compose": "^7.32.0",
		"@wordpress/data": "^10.32.0",
		"@wordpress/element": "^6.32.0",
		"@wordpress/i18n": "^6.4.0",
		"@wordpress/icons": "^12.2.0",
		"classnames": "^2.5.1",
		"react-hot-toast": "^2.6.0",
		"react-select": "^5.8.3",
		"react-toggle": "^4.1.3"
	}
}
